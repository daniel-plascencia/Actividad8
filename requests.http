// Requests to test the API from VS Code (REST Client extension)
@baseUrl = http://localhost:3000

################
# API AUTORES #
################
### GET AUTORES
GET {{baseUrl}}/api/autores

### GET AUTOR BY ID
GET {{baseUrl}}/api/autores/4

### POST AUTOR
POST {{baseUrl}}/api/autores
Content-Type: application/json

{
    "nombre": "Daniel Plascencia",
    "email": "daniel.plascencia@example.com",
    "imagen": "https://example.com/imagen.jpg"
}

### PUT AUTOR
PUT {{baseUrl}}/api/autores/1
Content-Type: application/json

{
    "nombre": "Daniel P. Gascon",
    "email": "daniel.plascencia@example.com",
    "imagen": "https://example.com/imagen.jpg"
}

### DELETE AUTOR
DELETE {{baseUrl}}/api/autores/2

################
# API POSTS #
################
### GET POSTS
GET {{baseUrl}}/api/posts

### GET POST BY ID
GET {{baseUrl}}/api/posts/1

### GET POSTS BY AUTOR ID
GET {{baseUrl}}/api/posts/autor/1

### POST POST
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
    "titulo": "Nuevo Post",
    "descripcion": "Descripción del nuevo post",
    "categoria": "Categoría del nuevo post",
    "autores_id": 1
}

### PUT POST
PUT {{baseUrl}}/api/posts/1
Content-Type: application/json

{
    "titulo": "Post Actualizado",
    "descripcion": "Descripción actualizada del post",
    "categoria": "Categoría actualizada del post",
    "autores_id": 1
}

### DELETE POST
DELETE {{baseUrl}}/api/posts/3

